{
  "manifest_version": 3,
  "name": "Clear Reply",
  "version": "1.0.3",
  "description": "Rewrite support-chat drafts into clear English.",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clear Reply",
    "default_icon": {
      "16": "dist/icons/16.png",
      "32": "dist/icons/32.png",
      "48": "dist/icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "dist/panel.html"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Clear Reply"
    }
  },
  "icons": {
    "16": "dist/icons/16.png",
    "32": "dist/icons/32.png",
    "48": "dist/icons/48.png",
    "128": "dist/icons/128.png"
  }
}
